{
  "name": "xuanshu-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @xuanshu/web dev",
    "build": "pnpm --filter @xuanshu/web build",
    "start": "pnpm --filter @xuanshu/web start",
    "lint": "pnpm --filter @xuanshu/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\check-release-readiness.ps1",
    "release:candidate": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\check-release-readiness.ps1 -DeferExternalGates"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    }
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
